rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null
        && (!firestore.exists(/databases/(default)/documents/accountStatus/$(request.auth.uid))
          || firestore.get(/databases/(default)/documents/accountStatus/$(request.auth.uid)).data.suspended != true);
    }
    function isConversationMember(conversationId) {
      return signedIn()
        && firestore.get(/databases/(default)/documents/conversations/$(conversationId)).data.participants.hasAny([request.auth.uid]);
    }
    function canUploadToConversation(conversationId) {
      let conversation = firestore.get(/databases/(default)/documents/conversations/$(conversationId)).data;
      let otherUid = conversation.participants[0] == request.auth.uid
        ? conversation.participants[1] : conversation.participants[0];
      return conversation.type == 'group'
        || (!firestore.exists(/databases/(default)/documents/users/$(request.auth.uid)/blocked/$(otherUid))
          && !firestore.exists(/databases/(default)/documents/users/$(otherUid)/blocked/$(request.auth.uid)));
    }
    match /users/{userId}/profile/{fileName} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.auth.uid == userId
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches("image/.*");
      allow delete: if signedIn() && request.auth.uid == userId;
    }

    match /conversations/{conversationId}/{userId}/{fileName} {
      allow read: if isConversationMember(conversationId);
      allow create: if isConversationMember(conversationId) && canUploadToConversation(conversationId)
        && userId == request.auth.uid
        && request.resource.size < 15 * 1024 * 1024
        && (request.resource.contentType.matches('image/.*')
          || request.resource.contentType.matches('audio/.*'));
      allow update, delete: if false;
    }
  }
}