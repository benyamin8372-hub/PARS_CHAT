rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function member(conversationId) {
      return signedIn()
        && exists(/databases/$(database)/documents/conversations/$(conversationId))
        && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
    }
    function blockedEitherWay(otherUid) {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid)/blocked/$(otherUid))
        || exists(/databases/$(database)/documents/users/$(otherUid)/blocked/$(request.auth.uid));
    }
    function canSendToConversation(conversationId) {
      let conversation = get(/databases/$(database)/documents/conversations/$(conversationId)).data;
      return conversation.type == 'group'
        || !blockedEitherWay(conversation.participants[0] == request.auth.uid
          ? conversation.participants[1] : conversation.participants[0]);
    }
    function admin() { return signedIn() && request.auth.token.admin == true; }

    match /users/{userId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.auth.uid == userId
        && request.resource.data.uid == userId
        && request.resource.data.keys().hasOnly(['uid','displayName','photoUrl','createdAt','lastSeen','online','showOnline','showLastSeen','blockedCount']);
      allow update: if signedIn() && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['displayName','photoUrl','lastSeen','online','showOnline','showLastSeen']);
      allow delete: if false;

      match /blocked/{blockedUid} {
        allow read: if signedIn() && request.auth.uid == userId;
        allow create: if signedIn() && request.auth.uid == userId
          && blockedUid != userId && request.resource.data.uid == blockedUid
          && request.resource.data.keys().hasOnly(['uid','createdAt']);
        allow delete: if signedIn() && request.auth.uid == userId;
        allow update: if false;
      }

      match /devices/{tokenId} {
        allow read, delete: if signedIn() && request.auth.uid == userId;
        allow create, update: if signedIn() && request.auth.uid == userId
          && request.resource.data.keys().hasOnly(['token','updatedAt'])
          && request.resource.data.token == tokenId;
      }
    }

    match /conversations/{conversationId} {
      allow read: if signedIn() && (request.auth.uid in resource.data.participants || admin());
      allow create: if signedIn()
        && request.resource.data.participants is list
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.participants.size() >= 2
        && request.resource.data.participants.size() <= 50
        && request.resource.data.createdBy == request.auth.uid
        && (
          (request.resource.data.type == 'private'
            && request.resource.data.participants.size() == 2
            && !blockedEitherWay(request.resource.data.participants[0] == request.auth.uid
              ? request.resource.data.participants[1] : request.resource.data.participants[0]))
          ||
          (request.resource.data.type == 'group'
            && request.resource.data.name is string
            && request.resource.data.name.size() >= 2
            && request.resource.data.name.size() <= 60
            && request.resource.data.admins == [request.auth.uid])
        );
      allow update: if signedIn() && request.auth.uid in resource.data.participants
        && request.resource.data.participants == resource.data.participants
        && (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['updatedAt','lastMessage','lastMessageAt'])
          || (resource.data.type == 'group'
            && request.auth.uid in resource.data.admins
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','updatedAt']))
        );
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if member(conversationId);
        allow create: if member(conversationId) && canSendToConversation(conversationId)
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.type in ['text','image','audio']
          && request.resource.data.createdAt == request.time
          && request.resource.data.readBy[request.auth.uid] == true
          && (
            (request.resource.data.type == 'text'
              && request.resource.data.text is string
              && request.resource.data.text.size() > 0
              && request.resource.data.text.size() <= 4000)
            ||
            (request.resource.data.type in ['image','audio']
              && request.resource.data.mediaUrl is string
              && request.resource.data.mimeType is string)
          )
          && request.resource.data.keys().hasOnly([
            'senderId','text','createdAt','type','readBy','replyToId','replyToText','mediaUrl','mimeType'
          ]);
        allow update: if member(conversationId) && (
          (resource.data.senderId == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text','editedAt'])
            && request.resource.data.text is string
            && request.resource.data.text.size() > 0
            && request.resource.data.text.size() <= 4000)
          ||
          (resource.data.senderId == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deleted','text','deletedAt'])
            && request.resource.data.deleted == true)
          ||
          (resource.data.senderId != request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy'])
            && request.resource.data.readBy[request.auth.uid] == true)
        );
        allow delete: if false;
      }
    }

    match /adminAudit/{eventId} { allow read: if admin(); allow write: if false; }

    match /adminStats/{document} {
      allow read: if admin();
      allow write: if false;
    }
  }
}